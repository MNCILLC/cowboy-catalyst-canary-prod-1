# Makeswift Site API Key
# In the Makeswift builder, go to Settings > Host and copy the API key for the site.
MAKESWIFT_SITE_API_KEY=

# The hash visible in the subject store's URL when signed in to the store control panel.
# The control panel URL is of the form `https://store-{hash}.mybigcommerce.com`.
BIGCOMMERCE_STORE_HASH=

# A JWT Token for accessing the Storefront API. Enables server-to-server requests if allowed_cors_origins is omitted.
# See https://developer.bigcommerce.com/docs/rest-authentication/tokens#storefront-tokens
BIGCOMMERCE_STOREFRONT_TOKEN=
BIGCOMMERCE_STOREFRONT_UNAUTHENTICATED_TOKEN=

# A store-level API account token used for REST API actions. Optional by default, but required in
# order for some components to work properly. For example, the `CustomerGroupSlot` Makeswift component
# requires a `BIGCOMMERCE_ACCESS_TOKEN` with `read-only` scope on Customers.
# Product-list metafield filters also require read-only Information & Settings scope
# to read custom_site option lists. Product attributes use the Storefront GraphQL API
# and must have storefront-readable permissions. Filter data is cached for 5 minutes.
# See https://support.bigcommerce.com/s/article/Store-API-Accounts?language=en_US
BIGCOMMERCE_ACCESS_TOKEN=

# The Channel ID for the selling channel being serviced by this Catalyst storefront.
# Channel ID 1 will allow you to load the same data being used on the default Stencil storefront on your store,
# but it is strongly recommended to create a new channel instead for production.
# The CLI can do this for you.
BIGCOMMERCE_CHANNEL_ID=1

# Set to true to allow the /admin route to redirect to the BigCommerce control panel.
# `false` is recommended for production. Defaults to false when not specified.
# You may also delete /admin/route.ts if you wish.
ENABLE_ADMIN_ROUTE=true

# Used by Auth.js, formerly NextAuth. To generate, run `openssl rand -hex 32` in your terminal.
AUTH_SECRET=

# Recommended so that you can use Turborepo's Remote Cache feature with signed artifacts
# https://turbo.build/repo/docs/core-concepts/remote-caching#artifact-integrity-and-authenticity-verification
# This can also be generated with `openssl rand -hex 32`, but do not re-use the value from AUTH_SECRET
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# NextJS will persists cached queries in Data Cache
# The time persisted is not defined
# https://nextjs.org/docs/app/building-your-application/caching#data-cache
# This sets a sensible revalidation target for cached requests
DEFAULT_REVALIDATE_TARGET=3600

# Minimum cart subtotal required before checkout. Defaults to 2000 when omitted or invalid.
MINIMUM_ORDER_SUBTOTAL=2000

# Show an info alert above the checkout button while the checkout subtotal is below the threshold.
# Set a positive threshold in cart currency units (for example, 100 means 100.00).
# Missing or invalid thresholds hide the alert. Match your BigCommerce shipping rules;
# these settings only control the message and do not configure free shipping.
SHOW_FREE_SHIPPING_MESSAGE=false
FREE_SHIPPING_THRESHOLD=

# Free-shipping alert colors: use one Tailwind color class per setting, without variants.
# These defaults apply when omitted or blank. Restart development or rebuild production
# after changing colors so Tailwind generates the configured classes.
FREE_SHIPPING_BACKGROUND_CLASS=bg-yellow-300
FREE_SHIPPING_TEXT_CLASS=text-foreground

# Require customers to log in before proceeding to checkout.
REQUIRE_AUTHENTICATION_FOR_CHECKOUT=false

# Display a notice above the cart checkout button with warehouse pickup instructions.
SHOW_SHIPPING_QUOTE_MESSAGE=false
SHIPPING_QUOTE_MESSAGE=

# Display a login prompt for wholesale pricing beneath product prices.
ENABLE_WHOLESALE_PRICING_MESSAGE=false

# Category used by the show PDP comparison table (first four products with a Show Name custom field).
SHOW_COMPARISON_CATEGORY_PATH=/july-4th

# OpenTelemetry Configuration (Optional)
# See OPENTELEMETRY.md for detailed setup and usage instructions
# See https://nextjs.org/docs/app/guides/open-telemetry for Next.js guide

# Set a custom service name for your traces (defaults to 'next-app')
# OTEL_SERVICE_NAME=catalyst-storefront

# Enable verbose tracing to see all spans (useful for debugging, increases data volume)
# NEXT_OTEL_VERBOSE=1

# Disable automatic fetch instrumentation (not recommended unless using custom instrumentation)
# NEXT_OTEL_FETCH_DISABLED=1

# Enable the grid/list view switcher on category, brand, and search pages.
# Defaults to true when omitted. Set false to hide the switcher and force grid view,
# ignoring saved list-view preferences. Restart the app after changing this setting.
ENABLE_PRODUCT_LIST_VIEW=true

# Show the attribute table on list-view product cards.
# Only true shows attributes; omitted or any other value hides them without affecting filters.
# Restart development or rebuild production after changing this setting.
ENABLE_PRODUCT_CARD_ATTRIBUTES=false

# Enable custom_site/custom_product metafield filtering and applied-filter chips.
# Only true enables custom filtering; omitted, false, or any other value uses native BigCommerce filters.
# Product-card attributes are controlled separately by ENABLE_PRODUCT_CARD_ATTRIBUTES.
# Restart development or rebuild production after changing this setting.
ENABLE_CUSTOM_PRODUCT_FILTERS=false

# Hide desktop and mobile product filters on category, brand, and search pages.
# Only true hides filters; omitted or any other value keeps them visible.
# Restart development or rebuild production after changing this setting.
HIDE_PRODUCT_FILTERS=false

# Hide the sort control on category, brand, and search pages.
# Only true hides sorting; omitted or any other value keeps it visible.
# Restart development or rebuild production after changing this setting.
HIDE_PRODUCT_SORT=false

# Customize visible stock messages. Only an explicit true enables each behavior.
# Missing, blank, or false values keep the existing stock text.
# false restores the existing quantity message for that stock condition.
# BigCommerce stock visibility settings and out-of-stock/backorder behavior still apply.
# Low stock uses the BigCommerce warning level and an error badge on show cards.
# Restart development or rebuild production after changing these settings.
ENABLE_LOW_STOCK_MESSAGE=false
ENABLE_IN_STOCK_MESSAGE=false

# Use crate-style stock badges on standard product cards and product details.
# Only true enables the enhanced display; false or omitted keeps the existing display.
# Existing stock visibility and stock-message settings still apply.
# Restart development or rebuild production after changing this setting.
ENABLE_ENHANCED_STOCK_DISPLAY=false

# Replace PDP specifications with a responsive table of standard and metafield attributes.
# Only true enables it; false or omitted preserves the existing specifications.
# Uses the same custom_product attributes and custom_site option labels as product cards.
# Metafields must be storefront-readable; custom_site labels require BIGCOMMERCE_ACCESS_TOKEN.
# Independent of ENABLE_PRODUCT_CARD_ATTRIBUTES and ENABLE_CUSTOM_PRODUCT_FILTERS.
# Restart development or rebuild production after changing this setting.
ENABLE_ENHANCED_PRODUCT_ATTRIBUTES=false

# Show the total quantity of this product (all variants) already in the cart beneath Add to cart
# on product detail pages and product list-view cards.
# Only true enables the display; false or omitted hides it and skips the cart quantity query.
# Restart development or rebuild production after changing this setting.
ENABLE_PRODUCT_CART_QUANTITY=false
