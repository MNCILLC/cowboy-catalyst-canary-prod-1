# Public example only. Supply real credentials through a private server env file.
# Staging stays non-purchasable; this does not activate hosted custom checkout.
WAREHOUSE_MODE=staging
WAREHOUSE_PERSISTENCE_PROVIDER=redis
WAREHOUSE_REDIS_URL=https://your-dedicated-redis.example
WAREHOUSE_REDIS_TOKEN=
WAREHOUSE_REDIS_NAMESPACE=warehouse-staging-store-channel
WAREHOUSE_VALIDATION_SECRET=
WAREHOUSE_VALIDATION_BASE_URL=https://storefront-staging.example
WAREHOUSE_CHECKOUT_ORIGINS='["https://checkout-staging.example"]'
# BIGCOMMERCE_STORE_HASH and BIGCOMMERCE_CHANNEL_ID must identify this backend.
WAREHOUSE_CONFIG='[{"id":"north","label":"Pickup North","pickupLabel":"Collect at North","locationId":101,"pickupMethodId":201,"allowShipping":false}]'
