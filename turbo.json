{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [".env.local"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "env": ["*"],
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".next-warehouse-staging/**",
        "!.next-warehouse-staging/cache/**",
        ".next-warehouse-preview/**",
        "!.next-warehouse-preview/cache/**"
      ]
    },
    "lint": {
      "env": ["*"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "env": ["*"],
      "dependsOn": ["topo"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["topo"]
    },
    "dev": {
      "env": ["*"],
      "cache": false,
      "persistent": true
    }
  }
}
